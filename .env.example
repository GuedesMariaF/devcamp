# ===========================================
# DevCamp - Environment Variables
# ===========================================
# Copie para .env e ajuste os valores

# Nome exibido na UI
VITE_APP_NAME="DevCamp"

# Base URL da API (sem barra no final)
VITE_API_BASE_URL="http://localhost:8000"

# URL da especificação OpenAPI/Swagger (usada pelo Orval)
VITE_API_SWAGGER_URL="http://localhost:8000/api/documentation"

# Chaves de armazenamento do JWT
VITE_TOKEN_STORAGE_KEY="devcamp_token"
VITE_REFRESH_TOKEN_STORAGE_KEY="devcamp_refresh_token"

# Envia cookies nas requisições (refresh via cookie httpOnly).
# Exige CORS com Allow-Credentials + Origin específica (não *).
# VITE_API_WITH_CREDENTIALS="true"
